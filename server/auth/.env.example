AUTH_PORT=8787
AUTH_TOKEN_SECRET=dev-change-me
AUTH_CODE_TTL_SEC=300
AUTH_CODE_COOLDOWN_SEC=60
AUTH_CODE_MAX_PER_HOUR=5
AUTH_TOKEN_TTL_SEC=86400
AUTH_REFRESH_TTL_SEC=7776000

MAIL_MODE=resend
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=MedPrism <noreply@yourdomain.com>
MAIL_DEBUG=0

# Comma-separated. `null` covers Electron packaged apps loaded via file://
CORS_ORIGIN=http://localhost:5173,null
HOSTED_DEFAULT_MODEL=deepseek-v4-flash

NEWAPI_BASE_URL=https://newapi.example.com
# Client-facing OpenAI-compatible base (direct mode). Do NOT set this to the auth server.
NEWAPI_PUBLIC_BASE_URL=https://newapi.example.com/v1
NEWAPI_ACCESS_TOKEN=
# Must be the numeric user id matching NEWAPI_ACCESS_TOKEN (e.g. 1)
NEWAPI_USER_ID=1
# Quota granted to each newly registered user's API key
NEWAPI_TOKEN_QUOTA=200

# Optional: return auth proxy to clients (apiKey = accessToken). Example:
# HOSTED_BASE_URL=https://auth.medhorizon.icu/v1
# When unset, clients call NEWAPI_PUBLIC_BASE_URL with the per-user NewAPI key.
# Global upstream override (optional). If unset, /v1 proxies with the user's NewAPI key.
# UPSTREAM_BASE_URL=https://newapi.example.com/v1
# UPSTREAM_API_KEY=
